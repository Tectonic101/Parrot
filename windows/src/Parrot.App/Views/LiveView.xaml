<!-- Parrot for Windows. Derived from Parrot (GPL-3.0), LiveRecordingView.swift + CopilotPanelView.swift. -->
<UserControl x:Class="Parrot.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="SharedTemplates.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Transcript -->
        <DockPanel Grid.Column="0" Margin="20,16,12,16">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="You" Style="{StaticResource CaptionText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <ProgressBar Width="70" Height="5" Maximum="1" Value="{Binding MeLevel, Mode=OneWay}" Foreground="{DynamicResource GoodBrush}" />
                        <TextBlock Text="Them" Style="{StaticResource CaptionText}" Margin="14,0,6,0" VerticalAlignment="Center" />
                        <ProgressBar Width="70" Height="5" Maximum="1" Value="{Binding ThemLevel, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource StopBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Elapsed}" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="14,4,0,0">
                            <Run Text="{Binding ProfileName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding EngineName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource WarnFillBrush}" CornerRadius="{StaticResource Radius}" Padding="10,6" Margin="0,10,0,0"
                        Visibility="{Binding ErrorText, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource BodyText}" FontSize="13" />
                </Border>
                <Border Background="{DynamicResource WarnFillBrush}" CornerRadius="{StaticResource Radius}" Padding="10,6" Margin="0,6,0,0"
                        Visibility="{Binding BacklogText, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding BacklogText}" Style="{StaticResource BodyText}" FontSize="13" />
                </Border>
                <TextBlock Text="TRANSCRIPT" Style="{StaticResource SectionLabel}" />
            </StackPanel>
            <Grid>
                <TextBlock Text="Listening… lines appear here a moment after someone stops speaking."
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Lines.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                <ListBox x:Name="TranscriptList" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource SegmentTemplate}"
                         ItemContainerStyle="{StaticResource BareListItem}" VirtualizingPanel.ScrollUnit="Pixel" />
            </Grid>
        </DockPanel>

        <!-- Copilot -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding TogglePauseCommand}"
                                Visibility="{Binding CopilotEnabled, Converter={StaticResource VisibleWhen}}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pause" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CopilotPaused}" Value="True">
                                                <Setter Property="Text" Value="Resume" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <TextBlock Text="ASSISTANT" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding CopilotStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CopilotHasProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CardRadius}" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding CoachLine, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoText}"
                                           Visibility="{Binding CallScore, Converter={StaticResource VisibleWhen}}">
                                    <Run Text="{Binding CallScore, Mode=OneWay}" /><Run Text="/100" />
                                </TextBlock>
                                <TextBlock Text="HOW IT'S GOING" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding CoachLine}" Style="{StaticResource BodyText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Brief for this call (optional)" Style="{StaticResource CaptionText}" />
                    <TextBox Text="{Binding Brief, UpdateSourceTrigger=PropertyChanged, Delay=500}" Margin="0,3,0,10"
                             ToolTip="e.g. 'Renewal with Acme — they want a discount; don't go below 10%.'" />
                </StackPanel>
                <Expander DockPanel.Dock="Bottom" Header="My notes" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0">
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="120" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                </Expander>
                <Grid>
                    <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding Insights.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                               Text="When the other side asks something, a suggested answer appears here — grounded in your knowledge base when it covers the topic." />
                    <ListBox x:Name="Cards" ItemsSource="{Binding Insights}" ItemContainerStyle="{StaticResource BareListItem}"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource InsightTemplate}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,4,10">
                                        <Button Style="{StaticResource SubtleButton}" Content="Handled"
                                                Command="{Binding DataContext.MarkHandledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" Visibility="{Binding IsOpenFlag, Converter={StaticResource VisibleWhen}}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Copy"
                                                Command="{Binding DataContext.CopyReplyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Dismiss"
                                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
