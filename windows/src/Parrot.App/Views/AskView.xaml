<!-- Parrot for Windows. Derived from Parrot (GPL-3.0), AskPageView.swift / AskAnswerView.swift. -->
<UserControl x:Class="Parrot.App.Views.AskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="20,16,20,16" MaxWidth="820" HorizontalAlignment="Stretch">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Ask Parrot" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,12"
                       Text="Ask about your past meetings — “What did I promise Acme?”, “Which calls mentioned pricing?”. Answers cite the meeting and moment." />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ask" Style="{StaticResource PrimaryButton}" Command="{Binding AskCommand}" Margin="8,0,0,0" IsDefault="True" />
                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" FontSize="14" />
            </DockPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource StopBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <ItemsControl ItemsSource="{Binding Exchanges}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Answer}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                           Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding Model}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                           Visibility="{Binding Model, Converter={StaticResource VisibleWhen}}" />
                                <Expander Header="Sources" Margin="0,8,0,0" Foreground="{DynamicResource Ink2Brush}"
                                          Visibility="{Binding Sources.Count, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Padding="0,2"
                                                            Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource Ink2Brush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
