<Application x:Class="Parrot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Parrot.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:KindBrushConverter x:Key="KindBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
